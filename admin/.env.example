# ============================================================
# Ghoomo Admin (Vite) — Environment Configuration
# All variables must be prefixed VITE_ to be exposed to the browser.
# Copy to admin/.env and fill in your values.
# NEVER commit real secrets.
# ============================================================

# ── Backend API ───────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:4000/api

# Optional dev proxy target used only when VITE_API_URL is left relative.
VITE_BACKEND_ORIGIN=http://127.0.0.1:4000
