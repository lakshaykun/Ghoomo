{
  "name": "ghoomo-platform",
  "version": "1.0.0",
  "description": "Ghoomo — Ride-sharing platform (monorepo: app + backend + admin)",
  "private": true,
  "workspaces": [
    "app",
    "backend",
    "admin"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix app && npm install --prefix backend && npm install --prefix admin",

    "dev": "concurrently --names \"backend,admin\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:admin\"",

    "dev:backend": "npm run dev --prefix backend",
    "dev:app": "npm start --prefix app",
    "dev:admin": "npm run dev --prefix admin",

    "build:app": "npm run build --prefix app",
    "build:android": "npm run build:android:apk --prefix app",
    "build:ios": "npm run build:ios --prefix app",
    "build:backend": "npm run build --prefix backend",
    "build:admin": "npm run build --prefix admin",

    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-path .gitignore",
    "format": "prettier --write .",

    "clean": "rm -rf node_modules app/node_modules backend/node_modules admin/node_modules app/.expo backend/.build admin/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
